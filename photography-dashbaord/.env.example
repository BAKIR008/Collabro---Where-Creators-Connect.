# ─────────────────────────────────────────────────────────────
# CollaBro Photography Dashboard — Environment Variables
#
# Copy this file to .env and fill in the values.
# All values must be blank here. Do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ─────────────────────────────────────────
# URL of the CollaBro Auth application (Login Page).
# Used to redirect unauthenticated users to sign in.
# Default (if left unset): http://localhost:5111
VITE_AUTH_APP_URL=

# ─────────────────────────────────────────────────────────────
# The photography dashboard frontend does NOT connect directly
# to MongoDB or any backend service. It proxies all /api
# requests through Vite to the CollaBro Auth server.
#
# Configure the Auth server separately using the .env file
# inside the "CollaBro Login Page" folder.
#
# Required variables on the Auth server:
#   PORT              — backend port (default: 5000)
#   MONGODB_URI       — MongoDB connection string
#   JWT_SECRET        — secret key for signing JWT tokens
#   JWT_EXPIRES_IN    — token lifetime (e.g. 7d)
#   COOKIE_SECRET     — secret for signed cookies
#   NODE_ENV          — development | production
#   CLIENT_URL        — URL of the main CollaBro frontend
# ─────────────────────────────────────────────────────────────
